---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Recipes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg-main, #FDFBF7);
		border-bottom: 1px solid var(--border-subtle, #EAE6DE);
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
		font-family: var(--font-serif, Georgia, serif);
		letter-spacing: -0.01em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #1A1917;
		font-weight: 600;
	}
	nav {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25em 0;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}
	nav a {
		padding: 0.25em 0;
		color: var(--text-muted, #5A554E);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	nav a:hover,
	nav a.active {
		color: #1A1917;
		border-bottom-color: var(--accent-green, #23372B);
	}
</style>