---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="brand">
			<a href="/" class="brand-link">
				<span class="brand-title">{SITE_TITLE}</span>
				<span class="brand-tagline">CULINARY ARCHIVE &bull; D.C.</span>
			</a>
		</div>

		<!-- Tactile Pill Navigation Track -->
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/recipes">Recipes</HeaderLink>
			<HeaderLink href="/journal">Journal</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: #FDFBF7;
		border-bottom: 1px solid #EAE6DE;
	}
	nav {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 0;
	}
	.brand-link {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		line-height: 1.1;
		gap: 0.35rem;
	}
	.brand-title {
		font-family: Georgia, serif;
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #1A1917;
	}
	.brand-tagline {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		color: #8C827A;
		font-weight: 600;
	}

	/* Tactile Segmented Track */
	.internal-links {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		background: #EFECE4;
		padding: 0.3rem 0.35rem;
		border-radius: 8px;
		border: 1px solid #DFD9CE;
		box-shadow: inset 0 1.5px 3px rgba(0, 0, 0, 0.06);
	}

	/* Tactile Button Links */
	.internal-links :global(a) {
		padding: 0.45rem 0.95rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: #5A554E;
		text-decoration: none;
		border-radius: 5px;
		border: 1px solid transparent;
		transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
		user-select: none;
	}

	.internal-links :global(a:hover) {
		color: #1A1917;
		background: rgba(255, 255, 255, 0.5);
	}

	/* Active Pressed Pill Card */
	.internal-links :global(a.active) {
		color: #1A1917 !important;
		background: #FFFFFF !important;
		border-color: #D3CCC0 !important;
		box-shadow: 
			0 1px 0 rgba(255, 255, 255, 0.9) inset,
			0 2px 4px rgba(0, 0, 0, 0.06) !important;
	}

	.internal-links :global(a:active) {
		transform: translateY(1px);
	}

	@media (max-width: 650px) {
		nav {
			flex-direction: column;
			gap: 1rem;
			align-items: flex-start;
		}
		.internal-links {
			width: 100%;
			justify-content: space-between;
		}
	}
</style>