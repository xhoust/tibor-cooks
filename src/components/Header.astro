---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="brand">
			<a href="/" class="brand-title">{SITE_TITLE}</a>
			<span class="brand-subtitle">Culinary Archive</span>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Recipes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		background: #FFFFFF;
		border-bottom: 1px solid #E8E5DF;
		padding: 1.25rem 2rem;
	}
	nav {
		max-width: 1280px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: flex;
		flex-direction: column;
	}
	.brand-title {
		font-family: Georgia, serif;
		font-size: 1.25rem;
		font-weight: 700;
		color: #1A1A1A;
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	.brand-subtitle {
		font-family: monospace;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: #2C3E35;
		font-weight: 600;
	}
	.internal-links {
		display: flex;
		gap: 1.5rem;
	}
	.internal-links :global(a) {
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		color: #6B6864;
		transition: color 0.15s ease;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: #9E472A;
		border-bottom: 2px solid #9E472A;
		padding-bottom: 0.2rem;
	}
</style>