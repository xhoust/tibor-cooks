---
interface Props {
	title: string;
	description?: string;
}

const { title, description = '' } = Astro.props;
---

<div class="share-container">
	<span class="share-label">Share:</span>
	<div class="share-buttons">
		<!-- Copy Link Button with Live Tooltip -->
		<button type="button" class="share-btn copy-btn" id="copyShareBtn" title="Copy link to clipboard">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
				<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
			</svg>
			<span id="copyText">Copy Link</span>
		</button>

		<!-- Facebook -->
		<a
			href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
			target="_blank"
			rel="noopener noreferrer"
			class="share-btn"
			title="Share on Facebook"
		>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
				<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
			</svg>
			<span>Facebook</span>
		</a>

		<!-- WhatsApp -->
		<a
			href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' — ' + Astro.url.href)}`}
			target="_blank"
			rel="noopener noreferrer"
			class="share-btn"
			title="Share via WhatsApp"
		>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
			</svg>
			<span>WhatsApp</span>
		</a>

		<!-- X / Twitter -->
		<a
			href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
			target="_blank"
			rel="noopener noreferrer"
			class="share-btn"
			title="Share on X"
		>
			<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
			</svg>
			<span>X</span>
		</a>

		<!-- Mobile Native / Instagram Share Handler -->
		<button type="button" class="share-btn" id="nativeShareBtn" title="More options / Instagram">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="18" cy="5" r="3"></circle>
				<circle cx="6" cy="12" r="3"></circle>
				<circle cx="18" cy="19" r="3"></circle>
				<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
				<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
			</svg>
			<span>Share</span>
		</button>
	</div>
</div>

<script>
	const copyBtn = document.getElementById('copyShareBtn');
	const copyText = document.getElementById('copyText');
	const nativeBtn = document.getElementById('nativeShareBtn');

	copyBtn?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(window.location.href);
			if (copyText) copyText.textContent = 'Copied!';
			setTimeout(() => {
				if (copyText) copyText.textContent = 'Copy Link';
			}, 2200);
		} catch (err) {
			console.error('Failed to copy', err);
		}
	});

	nativeBtn?.addEventListener('click', async () => {
		if (navigator.share) {
			try {
				await navigator.share({
					title: document.title,
					url: window.location.href,
				});
			} catch (_) {}
		} else {
			copyBtn?.click();
		}
	});
</script>

<style>
	.share-container {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.85rem;
		padding: 1.5rem 0;
		margin: 3rem 0 1.5rem 0;
		border-top: 1px solid var(--border-card, #DFD9CE);
		border-bottom: 1px solid var(--border-card, #DFD9CE);
	}
	.share-label {
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted, #7A746B);
		font-weight: 700;
	}
	.share-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.share-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: #FFFFFF;
		color: #2C2A26;
		border: 1px solid var(--border-card, #DFD9CE);
		padding: 0.42rem 0.75rem;
		border-radius: 4px;
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
		font-size: 0.74rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.15s ease;
		line-height: 1;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
	}
	.share-btn:hover {
		background: #FAF7F2;
		border-color: var(--accent-copper, #B24C24);
		color: var(--accent-copper, #B24C24);
		transform: translateY(-1px);
	}
</style>