---
// src/layouts/BlogPost.astro
const { frontmatter } = Astro.props;
---

<article class="recipe-card-container">
  <!-- Recipe Header -->
  <header class="recipe-header">
    {/* Tags Row */}
    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div class="tags-row">
        {frontmatter.tags.map((tag: string) => (
          <span class="tag-badge">{tag}</span>
        ))}
      </div>
    )}

    {/* Title & Description */}
    <h1 class="recipe-title">{frontmatter.title}</h1>
    {frontmatter.description && (
      <p class="recipe-description">{frontmatter.description}</p>
    )}

    {/* 3-Column Metadata Strip (No Chef / No Overflow) */}
    <div class="recipe-meta-grid">
      <div class="meta-box">
        <span class="meta-label">YIELD</span>
        <span class="meta-value">{frontmatter.yield}</span>
      </div>
      <div class="meta-box">
        <span class="meta-label">PREP</span>
        <span class="meta-value">{frontmatter.prepTime}</span>
      </div>
      <div class="meta-box">
        <span class="meta-label">COOK</span>
        <span class="meta-value">{frontmatter.cookTime}</span>
      </div>
    </div>
  </header>

  <!-- Recipe Markdown Body (Ingredients, Method, Chef's Tip) -->
  <div class="recipe-content">
    <slot />
  </div>
</article>
<style>
  .recipe-card-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    background-color: #f5f5f4;
    border: 1px solid #e7e5e4;
    border-radius: 4px;
    color: #44403c;
  }

  .recipe-title {
    font-family: serif;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 0.5rem 0;
    color: #1c1917;
  }

  .recipe-description {
    font-size: 1rem;
    line-height: 1.5;
    color: #57534e;
    margin: 0 0 1.25rem 0;
  }

  /* 3-Column Equal Grid */
  .recipe-meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    width: 100%;
    margin-bottom: 1.5rem;
    box-sizing: border-box;
  }

  .meta-box {
    background-color: #fafaf9;
    border: 1px solid #e7e5e4;
    border-radius: 4px;
    padding: 0.5rem 0.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-width: 0; /* Prevents text overflow blowouts */
  }

  .meta-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #78716c;
    margin-bottom: 0.15rem;
  }

  .meta-value {
    font-size: 0.85rem;
    font-weight: 600;
    color: #1c1917;
    line-height: 1.2;
    word-break: break-word;
  }
</style>