---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Tibor Markovič`} description={description} />
	</head>

	<body>
		<Header />
		<main class="spec-page">
			<article class="spec-card">
				<header class="spec-header">
					<div class="meta-badge">Standard Metric Spec &bull; Diplomatic Service</div>
					<h1 class="title">{title}</h1>
					{description && <p class="description">{description}</p>}
				</header>

				<div class="content-body">
					<slot />
				</div>
			</article>
		</main>
		<Footer />

		<style>
			:global(html), :global(body) {
				background-color: #F9F8F6;
				color: #1A1A1A;
			}
			.spec-page {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 3.5rem 1.5rem;
			}
			.spec-card {
				background: #FFFFFF;
				border: 1px solid #DFDBD3;
				border-radius: 8px;
				padding: 3.5rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
			}
			.spec-header {
				border-bottom: 1px solid #E8E5DF;
				padding-bottom: 1.75rem;
				margin-bottom: 2.25rem;
			}
			.meta-badge {
				font-family: monospace;
				font-size: 0.72rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #2C3E35;
				font-weight: 600;
				margin-bottom: 0.6rem;
			}
			.title {
				font-family: Georgia, serif;
				font-size: 2.6rem;
				font-weight: 700;
				margin: 0 0 0.6rem 0;
				color: #1A1A1A;
				line-height: 1.15;
			}
			.description {
				font-family: Georgia, serif;
				font-style: italic;
				font-size: 1.05rem;
				color: #6B6864;
				margin: 0;
				line-height: 1.55;
			}
			.content-body :global(h3) {
				font-family: Georgia, serif;
				font-size: 1.3rem;
				font-weight: 700;
				margin-top: 2.25rem;
				margin-bottom: 0.85rem;
				color: #1A1A1A;
				border-left: 3px solid #9E472A;
				padding-left: 0.75rem;
			}
			.content-body :global(p),
			.content-body :global(li) {
				font-size: 0.98rem;
				line-height: 1.75;
				color: #262626;
			}
			.content-body :global(ul),
			.content-body :global(ol) {
				padding-left: 1.35rem;
				margin-bottom: 1.5rem;
			}
			.content-body :global(li) {
				margin-bottom: 0.45rem;
			}
			.content-body :global(table) {
				width: 100%;
				border-collapse: collapse;
				margin: 1.75rem 0;
				display: block;
				overflow-x: auto;
			}
			.content-body :global(th),
			.content-body :global(td) {
				padding: 0.7rem 0.9rem;
				border: 1px solid #E8E5DF;
				font-size: 0.92rem;
			}
			.content-body :global(th) {
				background-color: #F9F8F6;
				color: #2C3E35;
				font-weight: 600;
			}

			@media (max-width: 640px) {
				.spec-page { padding: 1.25rem; }
				.spec-card { padding: 1.75rem 1.25rem; }
				.title { font-size: 1.85rem; }
			}
		</style>
	</body>
</html>