---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const featuredPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-container">
			<!-- Hero Banner -->
			<section class="hero-section">
				<span class="eyebrow">Washington, D.C. &bull; Resident Chef</span>
				<h1>Tibor Markovič</h1>
				<p class="bio">
					Standardized Central European recipes, diplomatic service formulations, and kitchen specifications.
				</p>
			</section>

			<!-- Featured Showcase -->
			<section class="showcase-section">
				<div class="section-title-row">
					<h2>Featured Formulations</h2>
					<a href="/blog" class="view-all-link">View all 12 recipes &rarr;</a>
				</div>

				<div class="cards-grid">
					{
						featuredPosts.map((post) => (
							<a href={`/blog/${post.id}/`} class="recipe-card">
								<div class="card-content">
									<span class="spec-tag">Metric Spec</span>
									<h3>{post.data.title}</h3>
									{post.data.description && <p>{post.data.description}</p>}
								</div>
								<div class="card-footer">
									<span>View Spec &rarr;</span>
								</div>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />

		<style>
			body {
				background-color: #fbfbfa;
				color: #1a1a1a;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
			}
			.home-container {
				max-width: 960px;
				margin: 0 auto;
				padding: 4rem 1.5rem;
			}
			.hero-section {
				margin-bottom: 4rem;
				border-bottom: 1px solid #e5e5e5;
				padding-bottom: 2.5rem;
			}
			.eyebrow {
				font-family: monospace;
				font-size: 0.72rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #777;
				display: block;
				margin-bottom: 0.5rem;
			}
			h1 {
				font-family: Georgia, serif;
				font-size: 2.8rem;
				font-weight: 700;
				margin: 0 0 0.75rem 0;
				color: #111;
			}
			.bio {
				font-family: Georgia, serif;
				font-size: 1.15rem;
				line-height: 1.6;
				color: #555;
				max-width: 620px;
				margin: 0;
			}
			.section-title-row {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 1.5rem;
			}
			.section-title-row h2 {
				font-family: Georgia, serif;
				font-size: 1.4rem;
				font-weight: 700;
				margin: 0;
				color: #111;
			}
			.view-all-link {
				font-size: 0.85rem;
				font-weight: 600;
				color: #111;
				text-decoration: none;
			}
			.view-all-link:hover {
				text-decoration: underline;
			}
			.cards-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
			}
			.recipe-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				background: #ffffff;
				border: 1px solid #e5e5e5;
				border-radius: 8px;
				padding: 1.5rem;
				text-decoration: none;
				color: inherit;
				transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
			}
			.recipe-card:hover {
				transform: translateY(-2px);
				border-color: #999;
				box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
			}
			.spec-tag {
				font-family: monospace;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #888;
				display: block;
				margin-bottom: 0.5rem;
			}
			.card-content h3 {
				font-family: Georgia, serif;
				font-size: 1.2rem;
				font-weight: 700;
				line-height: 1.3;
				margin: 0 0 0.5rem 0;
				color: #111;
			}
			.card-content p {
				font-size: 0.82rem;
				line-height: 1.5;
				color: #555;
				margin: 0;
			}
			.card-footer {
				margin-top: 1.5rem;
				padding-top: 0.75rem;
				border-top: 1px solid #f0f0f0;
				font-size: 0.8rem;
				font-weight: 600;
				color: #111;
			}
		</style>
	</body>
</html>