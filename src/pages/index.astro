---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const featuredPosts = (await getCollection('blog'))
	.sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0))
	.slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-container">
			<section class="hero-section">
				<span class="eyebrow">Washington, D.C. &bull; Resident Chef</span>
				<h1>Tibor Markovič</h1>
				<p class="bio">
					Standardized Central European recipes, diplomatic service formulations, and kitchen specifications.
				</p>
			</section>

			<section class="showcase-section">
				<div class="section-title-row">
					<h2>Featured Formulations</h2>
					<a href="/blog" class="view-all-link">View all recipes &rarr;</a>
				</div>

				<div class="cards-grid">
					{
						featuredPosts.map((post) => {
							const diff = post.data.difficulty || 'Intermediate';
							const diffClass = `tag-${diff.toLowerCase()}`;
							const time = post.data.time || '45 mins';
							const dietary = post.data.dietary || [];

							return (
								<a href={`/blog/${post.id}/`} class="recipe-card">
									<div class="card-content">
										<div class="tag-row">
											<span class={`mono-tag ${diffClass}`}>{diff}</span>
											<span class="mono-tag tag-time">{time}</span>
											{dietary.map((diet: string) => (
												<span class="mono-tag tag-diet">{diet}</span>
											))}
										</div>
										<h3>{post.data.title}</h3>
										{post.data.description && <p>{post.data.description}</p>}
									</div>
									<div class="card-footer">
										<span>View Recipe &rarr;</span>
									</div>
								</a>
							);
						})
					}
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.home-container {
				width: 100%;
				max-width: 1200px;
				margin: 0 auto;
				padding: 4.5rem 2rem;
			}
			.hero-section {
				margin-bottom: 3.5rem;
				border-bottom: 1px solid var(--border-card);
				padding-bottom: 2.75rem;
			}
			.eyebrow {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent-green);
				font-weight: 600;
				display: block;
				margin-bottom: 0.8rem;
			}
			h1 {
				font-size: 3.5rem;
				font-weight: 500;
				letter-spacing: -0.02em;
				margin: 0 0 0.85rem 0;
				line-height: 1.1;
			}
			.bio {
				font-family: var(--font-serif);
				font-style: italic;
				font-size: 1.25rem;
				line-height: 1.6;
				color: var(--text-muted);
				max-width: 680px;
				margin: 0;
			}
			.section-title-row {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 2rem;
			}
			.section-title-row h2 {
				font-size: 1.75rem;
				font-weight: 600;
				margin: 0;
			}
			.view-all-link {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--accent-copper);
				text-decoration: none;
			}
			.view-all-link:hover {
				color: var(--accent-hover);
				text-decoration: underline;
			}
			.cards-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 1.75rem;
			}
			.recipe-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				background: var(--card-bg);
				border: 1px solid var(--border-card);
				border-radius: 8px;
				padding: 2rem;
				text-decoration: none;
				color: inherit;
				box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03);
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}
			.recipe-card:hover {
				transform: translateY(-3px);
				border-color: var(--accent-green);
				box-shadow: 0 10px 24px rgba(44, 62, 53, 0.08);
			}
			.tag-row {
				display: flex;
				gap: 0.4rem;
				margin-bottom: 1.1rem;
				flex-wrap: wrap;
			}
			.card-content h3 {
				font-size: 1.45rem;
				font-weight: 600;
				line-height: 1.25;
				margin: 0 0 0.65rem 0;
			}
			.card-content p {
				font-size: 0.88rem;
				line-height: 1.55;
				color: var(--text-muted);
				margin: 0;
			}
			.card-footer {
				margin-top: 2rem;
				padding-top: 1rem;
				border-top: 1px solid var(--border-subtle);
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--accent-copper);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.recipe-card:hover .card-footer {
				color: var(--accent-hover);
			}
			@media (max-width: 640px) {
				.home-container { padding: 2.5rem 1.25rem; }
				h1 { font-size: 2.4rem; }
				.bio { font-size: 1.05rem; }
				.cards-grid { grid-template-columns: 1fr; gap: 1.25rem; }
			}
		</style>
	</body>
</html>