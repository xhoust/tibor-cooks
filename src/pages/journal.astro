---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Journal | ${SITE_TITLE}`} description="Stories on settling in the District, cross-country road trips, and notes from behind the diplomatic stove." />
	</head>
	<body>
		<Header />
		<main class="journal-container">
			<section class="journal-header">
				<span class="eyebrow">Personal Journal &amp; Field Notes</span>
				<h1>Journal</h1>
				<p class="journal-lead">
					Stories on settling in the District, cross-country road trips, and notes from behind the diplomatic stove.
				</p>
			</section>

			<section class="journal-feed">
				{
					posts.length === 0 ? (
						<p class="empty-state">No journal entries published yet.</p>
					) : (
						posts.map((post) => (
					<article class="journal-card">
	<a href={`/journal/${post.id}/`} class="card-link">
		<div class="card-content">
			<div class="card-meta-row">
				<span class="date-badge">
					<FormattedDate date={post.data.pubDate} />
				</span>
				{post.data.chapter && (
					<span class="chapter-badge">{post.data.chapter}.</span>
				)}
			</div>
			<h2>{post.data.title}</h2>
			<p class="description">{post.data.description}</p>
			<span class="read-more">Read Dispatch &rarr;</span>
		</div>
	</a>
</article>
						))
					)
				}
			</section>
		</main>
		<Footer />

		<style>
			.card-meta-row {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 0.9rem;
}

.date-badge {
	font-family: var(--font-mono, ui-monospace, monospace);
	font-size: 0.74rem;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	color: var(--accent-copper, #B24C24);
	font-weight: 600;
}

.chapter-badge {
	font-family: var(--font-mono, ui-monospace, monospace);
	font-size: 0.74rem;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--accent-green, #23372B);
	font-weight: 700;
	background: rgba(35, 55, 43, 0.06);
	padding: 0.2rem 0.5rem;
	border-radius: 4px;
}
			.journal-container {
				max-width: 840px;
				margin: 0 auto;
				padding: 4.5rem 1.5rem;
			}
			.journal-header {
				margin-bottom: 3.5rem;
				border-bottom: 1px solid var(--border-card, #DFD9CE);
				padding-bottom: 2rem;
			}
			.eyebrow {
				display: block;
				font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
				font-size: 0.72rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent-green, #23372B);
				font-weight: 600;
				margin-bottom: 0.8rem;
			}
			h1 {
				font-size: 3.5rem;
				font-weight: 500;
				letter-spacing: -0.02em;
				margin: 0 0 0.6rem 0;
				line-height: 1.1;
			}
			.journal-lead {
				font-family: var(--font-serif, Georgia, serif);
				font-style: italic;
				font-size: 1.25rem;
				color: var(--text-muted, #666);
				margin: 0;
			}
			.journal-feed {
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}
			.journal-card {
				background: var(--card-bg, #FFFFFF);
				border: 1px solid var(--border-card, #DFD9CE);
				border-radius: 8px;
				box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
				overflow: hidden;
			}
			.journal-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
				border-color: var(--accent-copper, #B24C24);
			}
			.card-link {
				text-decoration: none;
				color: inherit;
				display: block;
				padding: 2.2rem 2.5rem;
			}
			.card-meta {
				margin-bottom: 0.8rem;
			}
			.date-badge {
				font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
				font-size: 0.76rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--accent-copper, #B24C24);
				font-weight: 600;
			}
			.journal-card h2 {
				font-size: 1.85rem;
				font-weight: 600;
				color: #1A1917;
				margin: 0 0 0.8rem 0;
				line-height: 1.25;
			}
			.description {
				font-size: 1.02rem;
				line-height: 1.6;
				color: #4A4641;
				margin: 0 0 1.5rem 0;
			}
			.read-more {
				font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
				font-size: 0.82rem;
				font-weight: 600;
				color: var(--accent-green, #23372B);
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}
			.empty-state {
				font-family: var(--font-mono, monospace);
				color: var(--text-muted, #7A746B);
				padding: 3rem 0;
				text-align: center;
			}
			@media (max-width: 768px) {
				.journal-container {
					padding: 2.5rem 1.25rem;
				}
				.card-link {
					padding: 1.5rem 1.25rem;
				}
				h1 {
					font-size: 2.5rem;
				}
				.journal-card h2 {
					font-size: 1.45rem;
				}
			}
		</style>
	</body>
</html>