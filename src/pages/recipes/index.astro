---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const posts = (await getCollection('recipes')).sort(
    (a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0)
);

function getTagType(tag: string): string {
    const t = tag.toUpperCase().trim();

    // Time
    if (t.includes('MIN') || t.includes('HR') || t.includes('HOUR')) return 'tag-time';

    // Special Modifiers
    if (t.includes('FREEZER')) return 'tag-freezer';
    if (t === 'OVERNIGHT') return 'tag-overnight';
    if (t === 'FERMENTATION') return 'tag-ferment';

    // Courses / Stations
    if (['BAKERY', 'PASTRY'].includes(t)) return 'tag-bakes';
    if (t === 'SOUP') return 'tag-soup';
    if (t === 'MAINS') return 'tag-mains';
    if (t === 'SIDE') return 'tag-side';
    if (['DELI', 'SALAD'].includes(t)) return 'tag-fresh';
    if (t === 'DESSERT') return 'tag-dessert';
    if (t === 'PANTRY') return 'tag-pantry';

    // Core Proteins & Diets
    if (t === 'PORK') return 'tag-pork';
    if (t === 'BEEF') return 'tag-beef';
    if (t === 'POULTRY') return 'tag-poultry';
    if (t === 'FISH') return 'tag-fish';
    if (t === 'MUSHROOMS') return 'tag-mushrooms';
    if (['VEGETARIAN', 'VEGAN'].includes(t)) return 'tag-plant';

    return 'tag-default';
}

function getProcessedTags(tags: string[] = []): string[] {
    let list = tags.filter(t => t.toUpperCase() !== 'TRADITIONAL');

    list.sort((a, b) => {
        const score = (val: string) => {
            const u = val.toUpperCase().trim();
            if (u.includes('MIN') || u.includes('HR') || u.includes('HOUR')) return 4;
            if (['BAKERY', 'PASTRY', 'DELI', 'SALAD', 'SOUP', 'MAINS', 'SIDE', 'DESSERT', 'PANTRY'].includes(u)) return 3;
            if (['PORK', 'BEEF', 'POULTRY', 'FISH', 'MUSHROOMS', 'VEGETARIAN', 'VEGAN'].includes(u)) return 2;
            return 1;
        };
        return score(b) - score(a);
    });

    return list;
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`Recipes & Notes | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main>
            <section class="archive-header">
                <span class="eyebrow">RECIPE ARCHIVE</span>
                <h1 class="archive-title">Recipes & Notes</h1>
                <p class="archive-lead">
                    Traditional Slovak comfort food, embassy kitchen staples, and personal favorites.
                </p>

                <div class="search-wrap">
                    <input 
                        type="text" 
                        id="recipeSearch" 
                        placeholder="Search recipes (e.g. Sviečková, Halušky, Lokše)..." 
                        autocomplete="off"
                    />
                </div>
            </section>

            <section class="recipes-grid" id="recipeGrid">
                {
                    posts.map((post) => {
                        const rawTags: string[] = post.data.tags || [];
                        const processedTags = getProcessedTags(rawTags);

                        return (
                            <div class="flip-card-scene" data-title={post.data.title.toLowerCase()} data-tags={processedTags.join(' ').toLowerCase()}>
                                <div class="flip-card-inner">
                                    <!-- FRONT FACE -->
                                    <article class="recipe-card card-front">
                                        {processedTags.length > 0 && (
                                            <div class="tag-pills-row">
                                                {processedTags.map((tag: string) => (
                                                    <span class={`tag-pill ${getTagType(tag)}`}>{tag}</span>
                                                ))}
                                            </div>
                                        )}

                                        <h2 class="recipe-card-title">{post.data.title}</h2>

                                        {post.data.description && (
                                            <p class="recipe-card-desc">{post.data.description}</p>
                                        )}

                                        <div class="card-bottom-spacer"></div>
                                        <hr class="card-divider" />

                                        <div class="card-footer-row">
                                            <button type="button" class="flip-trigger-btn" aria-label="Flip for photo">
                                                Photo ↻
                                            </button>
                                            <a href={`/recipes/${post.id}/`} class="view-recipe-link">
                                                VIEW RECIPE &rarr;
                                            </a>
                                        </div>
                                    </article>

                                    <!-- BACK FACE -->
                                    <article class="recipe-card card-back">
                                        {post.data.image ? (
                                            <div class="back-photo-full js-lightbox-trigger" data-img-src={post.data.image} data-img-title={post.data.title} title="Click to enlarge photo">
                                                <img src={post.data.image} alt={post.data.title} loading="lazy" />
                                                <div class="back-photo-scrim"></div>

                                                <span class="zoom-badge">⤢ Zoom</span>

                                                <div class="back-photo-footer">
                                                    <button type="button" class="flip-trigger-btn flip-glass-btn" aria-label="Flip back to front">
                                                        ↺ Front
                                                    </button>
                                                    <a href={`/recipes/${post.id}/`} class="view-recipe-btn view-glass-btn">
                                                        VIEW RECIPE &rarr;
                                                    </a>
                                                </div>
                                            </div>
                                        ) : (
                                            <div class="back-no-photo">
                                                <span class="eyebrow">NO PHOTO YET</span>
                                                <h3 class="back-title">{post.data.title}</h3>
                                                <div class="card-bottom-spacer"></div>
                                                <hr class="card-divider" />
                                                <div class="card-footer-row">
                                                    <button type="button" class="flip-trigger-btn" aria-label="Flip back to front">
                                                        ↺ Front
                                                    </button>
                                                    <a href={`/recipes/${post.id}/`} class="view-recipe-btn">
                                                        VIEW RECIPE &rarr;
                                                    </a>
                                                </div>
                                            </div>
                                        )}
                                    </article>
                                </div>
                            </div>
                        );
                    })
                }
            </section>
        </main>

        <!-- Full-Screen Lightbox Modal -->
        <dialog id="recipeLightbox" class="lightbox-modal">
            <div class="lightbox-content">
                <button type="button" class="lightbox-close-btn" id="lightboxCloseBtn" aria-label="Close image">✕</button>
                <img id="lightboxImg" src="" alt="" />
                <p id="lightboxCaption" class="lightbox-caption"></p>
            </div>
        </dialog>

        <Footer />

        <!-- Scripts -->
        <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
                // Search filter
                const searchInput = document.getElementById('recipeSearch');
                const grid = document.getElementById('recipeGrid');
                if (searchInput && grid) {
                    const items = Array.from(grid.children);
                    searchInput.addEventListener('input', (e) => {
                        const query = e.target.value.toLowerCase().trim();
                        items.forEach((item) => {
                            const title = item.getAttribute('data-title') || '';
                            const tags = item.getAttribute('data-tags') || '';
                            if (title.includes(query) || tags.includes(query)) {
                                item.style.display = 'flex';
                            } else {
                                item.style.display = 'none';
                            }
                        });
                    });
                }

                // Flip trigger
                document.querySelectorAll('.flip-card-scene').forEach((card) => {
                    const triggers = card.querySelectorAll('.flip-trigger-btn');
                    triggers.forEach((btn) => {
                        btn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            card.classList.toggle('is-flipped');
                        });
                    });
                });

                // Lightbox zoom logic
                const lightbox = document.getElementById('recipeLightbox');
                const lightboxImg = document.getElementById('lightboxImg');
                const lightboxCaption = document.getElementById('lightboxCaption');
                const lightboxClose = document.getElementById('lightboxCloseBtn');

                if (lightbox && lightboxImg) {
                    document.querySelectorAll('.js-lightbox-trigger').forEach((wrap) => {
                        wrap.addEventListener('click', (e) => {
                            // Don't trigger zoom if clicking footer buttons
                            if (e.target.closest('.back-photo-footer')) return;
                            
                            const src = wrap.getAttribute('data-img-src');
                            const title = wrap.getAttribute('data-img-title');
                            if (src) {
                                lightboxImg.src = src;
                                lightboxImg.alt = title || '';
                                if (lightboxCaption) lightboxCaption.textContent = title || '';
                                lightbox.showModal();
                            }
                        });
                    });

                    // Close handlers
                    lightboxClose?.addEventListener('click', () => lightbox.close());
                    lightbox.addEventListener('click', (e) => {
                        if (e.target === lightbox) lightbox.close();
                    });
                }
            });
        </script>

        <style>
            main {
                max-width: 1140px;
                margin: 0 auto;
                padding: 3.5rem 1.5rem 6rem 1.5rem;
            }

            .archive-header {
                margin-bottom: 3.5rem;
            }

            .eyebrow {
                display: block;
                font-family: var(--font-mono);
                font-size: 0.72rem;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: #7A746B;
                font-weight: 600;
                margin-bottom: 0.75rem;
            }

            .archive-title {
                font-family: var(--font-serif);
                font-size: 3.2rem;
                line-height: 1.1;
                font-weight: 700;
                color: #1A1917;
                margin: 0 0 0.85rem 0;
                letter-spacing: -0.02em;
            }

            .archive-lead {
                font-family: var(--font-serif);
                font-style: italic;
                font-size: 1.15rem;
                color: #5A554E;
                line-height: 1.5;
                margin: 0 0 2rem 0;
            }

            .search-wrap {
                max-width: 440px;
            }

            .search-wrap input {
                width: 100%;
                padding: 0.75rem 1rem;
                font-size: 0.88rem;
                font-family: inherit;
                border: 1px solid #D8D2C4;
                border-radius: 6px;
                background: #FFFFFF;
                color: #1A1917;
                outline: none;
                box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
                transition: border-color 0.15s ease;
            }

            .search-wrap input:focus {
                border-color: #23372B;
            }

            /* Grid Layout */
            .recipes-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }

            @media (max-width: 960px) {
                .recipes-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (max-width: 620px) {
                .recipes-grid {
                    grid-template-columns: 1fr;
                }
                .archive-title {
                    font-size: 2.5rem;
                }
            }
        </style>
    </body>
</html>