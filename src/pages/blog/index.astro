---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0)
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Recipes | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="archive-container">
			<div class="archive-header">
				<span class="eyebrow">Culinary Archive</span>
				<h1>Recipe Formulations</h1>
				<p class="subtitle">Standardized metric specifications, method parameters, and embassy kitchen standards.</p>
				
				<div class="search-wrap">
					<input
						type="text"
						id="recipe-search"
						placeholder="Search formulations (e.g. Sviečková, Halúšky, Lokše)..."
					/>
				</div>
			</div>

			<div id="recipe-grid" class="cards-grid">
				{
					posts.map((post) => {
						const diff = post.data.difficulty || 'Intermediate';
						const diffClass = `tag-${diff.toLowerCase()}`;
						return (
							<a 
								href={`/blog/${post.id}/`} 
								class="recipe-card"
								data-title={post.data.title.toLowerCase()}
								data-desc={(post.data.description || '').toLowerCase()}
							>
								<div class="card-content">
									<div class="tag-row">
										<span class={`mono-tag ${diffClass}`}>{diff}</span>
										{post.data.category && (
											<span class="mono-tag tag-neutral">{post.data.category}</span>
										)}
									</div>
									<h2>{post.data.title}</h2>
									{post.data.description && <p>{post.data.description}</p>}
								</div>
								<div class="card-footer">
									<span>View Formulation &rarr;</span>
								</div>
							</a>
						);
					})
				}
			</div>

			<div id="no-results" class="no-results hidden">
				<p>No formulations found matching your search.</p>
			</div>
		</main>
		<Footer />

		<script>
			const searchInput = document.getElementById('recipe-search') as HTMLInputElement;
			const cards = document.querySelectorAll('.recipe-card') as NodeListOf<HTMLElement>;
			const noResults = document.getElementById('no-results');

			searchInput?.addEventListener('input', (e) => {
				const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
				let visibleCount = 0;

				cards.forEach((card) => {
					const title = card.getAttribute('data-title') || '';
					const desc = card.getAttribute('data-desc') || '';

					if (title.includes(query) || desc.includes(query)) {
						card.style.display = 'flex';
						visibleCount++;
					} else {
						card.style.display = 'none';
					}
				});

				if (noResults) {
					if (visibleCount === 0) {
						noResults.classList.remove('hidden');
					} else {
						noResults.classList.add('hidden');
					}
				}
			});
		</script>

		<style>
			.archive-container {
				width: 100%;
				max-width: 1200px;
				margin: 0 auto;
				padding: 4.5rem 2rem;
			}
			.eyebrow {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: var(--accent-green);
				font-weight: 600;
				display: block;
				margin-bottom: 0.8rem;
			}
			.archive-header {
				margin-bottom: 3.5rem;
				border-bottom: 1px solid var(--border-card);
				padding-bottom: 2.5rem;
			}
			.archive-header h1 {
				font-size: 3.2rem;
				font-weight: 500;
				letter-spacing: -0.02em;
				margin: 0 0 0.75rem 0;
			}
			.subtitle {
				font-family: var(--font-serif);
				font-style: italic;
				color: var(--text-muted);
				font-size: 1.15rem;
				margin: 0 0 2rem 0;
				line-height: 1.55;
			}
			.search-wrap input {
				width: 100%;
				max-width: 460px;
				padding: 0.85rem 1.1rem;
				font-size: 0.92rem;
				border: 1px solid var(--border-card);
				border-radius: 6px;
				background-color: var(--card-bg);
				color: var(--text-main);
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.search-wrap input:focus {
				border-color: var(--accent-green);
				box-shadow: 0 0 0 1px var(--accent-green);
			}
			.cards-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 1.75rem;
				width: 100%;
			}
			.recipe-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				background: var(--card-bg);
				border: 1px solid var(--border-card);
				border-radius: 8px;
				padding: 2rem;
				text-decoration: none;
				color: inherit;
				box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03);
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}
			.recipe-card:hover {
				transform: translateY(-3px);
				border-color: var(--accent-green);
				box-shadow: 0 10px 24px rgba(44, 62, 53, 0.08);
			}
			.tag-row {
				display: flex;
				gap: 0.5rem;
				margin-bottom: 1.1rem;
				flex-wrap: wrap;
			}
			.card-content h2 {
				font-size: 1.45rem;
				font-weight: 600;
				line-height: 1.25;
				margin: 0 0 0.65rem 0;
			}
			.card-content p {
				font-size: 0.88rem;
				line-height: 1.55;
				color: var(--text-muted);
				margin: 0;
			}
			.card-footer {
				margin-top: 2rem;
				padding-top: 1rem;
				border-top: 1px solid var(--border-subtle);
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--accent-copper);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.recipe-card:hover .card-footer {
				color: var(--accent-hover);
			}
			.no-results {
				padding: 4rem 0;
				text-align: center;
				color: var(--text-muted);
				font-family: var(--font-serif);
				font-style: italic;
			}
			.hidden {
				display: none;
			}
			@media (max-width: 640px) {
				.archive-container { padding: 2.5rem 1.25rem; }
				.archive-header h1 { font-size: 2.4rem; }
				.cards-grid { grid-template-columns: 1fr; gap: 1.25rem; }
			}
		</style>
	</body>
</html>