---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0)
);

function formatTimeTag(tag: string): string {
	const upper = tag.toUpperCase().trim();
	
	// Check for hours
	const hrMatch = upper.match(/(\d+(\.\d+)?)\s*(HRS?|HOURS?)/);
	if (hrMatch) {
		const hours = parseFloat(hrMatch[1]);
		if (hours >= 2) return `${tag} >`;
		return `${tag} >>`;
	}

	// Check for minutes
	const minMatch = upper.match(/(\d+)\s*(MINS?|MINUTES?)/);
	if (minMatch) {
		const mins = parseInt(minMatch[1], 10);
		if (mins <= 30) return `${tag} >>>`;
		if (mins < 120) return `${tag} >>`;
		return `${tag} >`;
	}

	return tag;
}

function getTagType(tag: string): string {
	const t = tag.toUpperCase();
	if (t.includes('MIN') || t.includes('HR') || t.includes('HOUR')) return 'tag-time';
	if (t.includes('OVERNIGHT')) return 'tag-overnight';
	if (['ITALIAN', 'FRENCH', 'AUSTRIAN', 'AMERICAN', 'GLOBAL', 'MEDITERRANEAN', 'INTERNATIONAL', 'IRISH', 'ASIAN'].includes(t)) return 'tag-origin';
	if (['PORK', 'BEEF', 'DUCK', 'POULTRY', 'CHICKEN', 'FISH', 'POTATO', 'CHEESE', 'BRYNDZA', 'FRUIT', 'MUSHROOM', 'BREADS'].includes(t)) return 'tag-element';
	if (['MAIN COURSES', 'SIDES', 'DESSERTS', 'BAKING', 'SOUPS', 'SALADS'].includes(t)) return 'tag-course';
	if (['VEGETARIAN', 'VEGAN', 'NUT-FREE', 'GF', 'DF'].includes(t)) return 'tag-diet';
	return 'tag-default';
}

function getProcessedTags(tags: string[], description: string = ''): string[] {
	// Strip out 'TRADITIONAL' by default
	let list = tags.filter(t => t.toUpperCase() !== 'TRADITIONAL');

	const hasOvernight = list.some(t => t.toUpperCase().includes('OVERNIGHT')) || 
	                     description.toLowerCase().includes('overnight');

	// Prioritize: 1. Time, 2. Origin (if abroad), 3. Protein/Core Element, 4. Course / Diet
	list.sort((a, b) => {
		const score = (val: string) => {
			const u = val.toUpperCase();
			if (u.includes('MIN') || u.includes('HR')) return 4;
			if (['ITALIAN', 'FRENCH', 'AUSTRIAN', 'AMERICAN', 'GLOBAL', 'MEDITERRANEAN', 'INTERNATIONAL', 'IRISH', 'ASIAN'].includes(u)) return 3;
			if (['PORK', 'BEEF', 'DUCK', 'POULTRY', 'CHICKEN', 'FISH', 'POTATO', 'CHEESE', 'BRYNDZA', 'FRUIT', 'MUSHROOM', 'BREADS'].includes(u)) return 2;
			return 1;
		};
		return score(b) - score(a);
	});

	if (hasOvernight && !list.some(t => t.toUpperCase() === 'OVERNIGHT')) {
		list.splice(1, 0, 'OVERNIGHT');
	}

	return list;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Recipes & Notes | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-header">
				<span class="eyebrow">RECIPE ARCHIVE</span>
				<h1 class="archive-title">Recipes & Notes</h1>
				<p class="archive-lead">
					Traditional Slovak comfort food, embassy kitchen staples, and personal favorites.
				</p>

				<div class="search-wrap">
					<input 
						type="text" 
						id="recipeSearch" 
						placeholder="Search recipes (e.g. Sviečková, Halušky, Lokše)..." 
						autocomplete="off"
					/>
				</div>
			</section>

			<section class="recipes-grid" id="recipeGrid">
				{
					posts.map((post) => {
						const rawTags: string[] = post.data.tags || [];
						const processedTags = getProcessedTags(rawTags, post.data.description);

						return (
							<article class="recipe-card" data-title={post.data.title.toLowerCase()} data-tags={processedTags.join(' ').toLowerCase()}>
								{processedTags.length > 0 && (
									<div class="tag-pills-row">
										{processedTags.map((tag: string) => {
											const isTime = tag.toUpperCase().includes('MIN') || tag.toUpperCase().includes('HR');
											const displayLabel = isTime ? formatTimeTag(tag) : tag;
											return (
												<span class={`tag-pill ${getTagType(tag)}`}>{displayLabel}</span>
											);
										})}
									</div>
								)}

								<h2 class="recipe-card-title">{post.data.title}</h2>
								
								{post.data.description && (
									<p class="recipe-card-desc">{post.data.description}</p>
								)}

								<div class="card-bottom-spacer"></div>

								<hr class="card-divider" />

								<a href={`/blog/${post.id}/`} class="view-recipe-link">
									VIEW RECIPE &rarr;
								</a>
							</article>
						);
					})
				}
			</section>
		</main>
		<Footer />

		<!-- Client-side Instant Filter -->
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const searchInput = document.getElementById('recipeSearch');
				const grid = document.getElementById('recipeGrid');
				if (!searchInput || !grid) return;

				const cards = Array.from(grid.querySelectorAll('.recipe-card'));

				searchInput.addEventListener('input', (e) => {
					const query = e.target.value.toLowerCase().trim();
					cards.forEach((card) => {
						const title = card.getAttribute('data-title') || '';
						const tags = card.getAttribute('data-tags') || '';
						if (title.includes(query) || tags.includes(query)) {
							card.style.display = 'flex';
						} else {
							card.style.display = 'none';
						}
					});
				});
			});
		</script>

		<style>
			main {
				max-width: 1140px;
				margin: 0 auto;
				padding: 3.5rem 1.5rem 6rem 1.5rem;
			}

			.archive-header {
				margin-bottom: 3.5rem;
			}

			.eyebrow {
				display: block;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #7A746B;
				font-weight: 600;
				margin-bottom: 0.75rem;
			}

			.archive-title {
				font-family: Georgia, serif;
				font-size: 3.2rem;
				line-height: 1.1;
				font-weight: 700;
				color: #1A1917;
				margin: 0 0 0.85rem 0;
				letter-spacing: -0.02em;
			}

			.archive-lead {
				font-family: Georgia, serif;
				font-style: italic;
				font-size: 1.15rem;
				color: #5A554E;
				line-height: 1.5;
				margin: 0 0 2rem 0;
			}

			.search-wrap {
				max-width: 440px;
			}

			.search-wrap input {
				width: 100%;
				padding: 0.75rem 1rem;
				font-size: 0.88rem;
				font-family: inherit;
				border: 1px solid #D8D2C4;
				border-radius: 6px;
				background: #FFFFFF;
				color: #1A1917;
				outline: none;
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
				transition: border-color 0.15s ease;
			}

			.search-wrap input:focus {
				border-color: #23372B;
			}

			/* Grid Layout */
			.recipes-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
			}

			.recipe-card {
				background: #FFFFFF;
				border: 1px solid #DFD9CE;
				border-radius: 10px;
				padding: 1.75rem 1.6rem 1.4rem 1.6rem;
				display: flex;
				flex-direction: column;
				box-shadow: 
					0 1px 0 rgba(255, 255, 255, 0.9) inset,
					0 2px 8px rgba(0, 0, 0, 0.03);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.recipe-card:hover {
				transform: translateY(-2px);
				box-shadow: 
					0 1px 0 rgba(255, 255, 255, 0.9) inset,
					0 6px 18px rgba(0, 0, 0, 0.06);
			}

			/* Color-Coded Tag Pills */
			.tag-pills-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-bottom: 1.25rem;
			}

			.tag-pill {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				padding: 0.22rem 0.55rem;
				border-radius: 4px;
				border: 1px solid transparent;
				white-space: nowrap;
			}

			/* Time: Warm Amber / Ochre with Speed Indicators */
			.tag-pill.tag-time {
				background: #FBF4E8;
				border-color: #EBDEC5;
				color: #935B16;
				letter-spacing: 0.08em;
			}

			/* Overnight Prep: Deep Plum / Wine Accent */
			.tag-pill.tag-overnight {
				background: #F4EEF7;
				border-color: #E2D3E8;
				color: #6D3B7D;
			}

			/* Origin / Abroad: Terracotta Red */
			.tag-pill.tag-origin {
				background: #FBEFEF;
				border-color: #E8CDCD;
				color: #A33838;
			}

			/* Protein / Core Element: Warm Rust / Caramel */
			.tag-pill.tag-element {
				background: #F8EFEA;
				border-color: #EAD3C6;
				color: #964821;
			}

			/* Course: Forest Olive */
			.tag-pill.tag-course {
				background: #EAEFEA;
				border-color: #CADBCB;
				color: #2D4A34;
			}

			/* Dietary: Earthy Slate / Soft Blue */
			.tag-pill.tag-diet {
				background: #EFF3F7;
				border-color: #D3DEE8;
				color: #3B6180;
			}

			/* Default / Fallback: Parchment */
			.tag-pill.tag-default {
				background: #F4F1EA;
				border-color: #E2DBD0;
				color: #6B635B;
			}

			.recipe-card-title {
				font-family: Georgia, serif;
				font-size: 1.45rem;
				line-height: 1.25;
				font-weight: 700;
				color: #1A1917;
				margin: 0 0 0.85rem 0;
			}

			.recipe-card-desc {
				font-size: 0.9rem;
				line-height: 1.55;
				color: #5A554E;
				margin: 0;
			}

			.card-bottom-spacer {
				flex-grow: 1;
				min-height: 1.5rem;
			}

			.card-divider {
				border: 0;
				height: 1px;
				background: #EAE6DE;
				margin: 0 0 1rem 0;
			}

			.view-recipe-link {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.78rem;
				font-weight: 700;
				color: #B24C24;
				text-decoration: none;
				letter-spacing: 0.04em;
				align-self: flex-start;
			}

			.view-recipe-link:hover {
				text-decoration: underline;
			}

			@media (max-width: 960px) {
				.recipes-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 620px) {
				.recipes-grid {
					grid-template-columns: 1fr;
				}
				.archive-title {
					font-size: 2.5rem;
				}
			}
		</style>
	</body>
</html>