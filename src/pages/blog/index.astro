---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Recipes | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="archive-container">
			<div class="archive-header">
				<span class="eyebrow">Culinary Archive</span>
				<h1>Recipe Archive</h1>
				<p class="subtitle">Standardized formulations, method parameters, and metric specifications.</p>
				
				<div class="search-wrap">
					<input
						type="text"
						id="recipe-search"
						placeholder="Search formulations (e.g. Sviečková, Halúšky, Lokše)..."
					/>
				</div>
			</div>

			<div id="recipe-grid" class="cards-grid">
				{
					posts.map((post) => (
						<a 
							href={`/blog/${post.id}/`} 
							class="recipe-card"
							data-title={post.data.title.toLowerCase()}
							data-desc={(post.data.description || '').toLowerCase()}
						>
							<div class="card-content">
								<span class="spec-tag">Standard Metric Spec</span>
								<h2>{post.data.title}</h2>
								{post.data.description && <p>{post.data.description}</p>}
							</div>
							<div class="card-footer">
								<span>View Formulation &rarr;</span>
							</div>
						</a>
					))
				}
			</div>

			<div id="no-results" class="no-results hidden">
				<p>No formulations found matching your search.</p>
			</div>
		</main>
		<Footer />

		<script>
			const searchInput = document.getElementById('recipe-search') as HTMLInputElement;
			const cards = document.querySelectorAll('.recipe-card') as NodeListOf<HTMLElement>;
			const noResults = document.getElementById('no-results');

			searchInput?.addEventListener('input', (e) => {
				const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
				let visibleCount = 0;

				cards.forEach((card) => {
					const title = card.getAttribute('data-title') || '';
					const desc = card.getAttribute('data-desc') || '';

					if (title.includes(query) || desc.includes(query)) {
						card.style.display = 'flex';
						visibleCount++;
					} else {
						card.style.display = 'none';
					}
				});

				if (noResults) {
					if (visibleCount === 0) {
						noResults.classList.remove('hidden');
					} else {
						noResults.classList.add('hidden');
					}
				}
			});
		</script>

		<style>
			:global(html), :global(body) {
				max-width: 100vw;
				overflow-x: hidden;
			}
			*, *::before, *::after {
				box-sizing: border-box;
			}
			body {
				background-color: #fbfbfa;
				color: #1a1a1a;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				margin: 0;
				padding: 0;
			}
			.archive-container {
				width: 100%;
				max-width: 1280px;
				margin: 0 auto;
				padding: 3.5rem 2rem;
			}
			.eyebrow {
				font-family: monospace;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: #888;
				display: block;
				margin-bottom: 0.4rem;
			}
			.archive-header {
				margin-bottom: 2.5rem;
			}
			.archive-header h1 {
				font-family: Georgia, serif;
				font-size: 2.5rem;
				font-weight: 700;
				margin: 0 0 0.5rem 0;
				color: #111;
			}
			.subtitle {
				color: #666;
				font-size: 0.95rem;
				margin: 0 0 1.5rem 0;
				line-height: 1.5;
			}
			.search-wrap {
				width: 100%;
			}
			.search-wrap input {
				width: 100%;
				max-width: 440px;
				padding: 0.8rem 1rem;
				font-size: 0.92rem;
				border: 1px solid #d4d4d4;
				border-radius: 6px;
				background-color: #fff;
				color: #111;
				outline: none;
				box-sizing: border-box;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.search-wrap input:focus {
				border-color: #111;
				box-shadow: 0 0 0 1px #111;
			}
			.cards-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
				width: 100%;
			}
			.recipe-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				background: #ffffff;
				border: 1px solid #e5e5e5;
				border-radius: 8px;
				padding: 1.5rem;
				text-decoration: none;
				color: inherit;
				box-sizing: border-box;
				width: 100%;
				transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
			}
			.recipe-card:hover {
				transform: translateY(-2px);
				border-color: #999;
				box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
			}
			.spec-tag {
				font-family: monospace;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #888;
				display: block;
				margin-bottom: 0.5rem;
			}
			.card-content h2 {
				font-family: Georgia, serif;
				font-size: 1.25rem;
				font-weight: 700;
				line-height: 1.3;
				margin: 0 0 0.5rem 0;
				color: #111;
			}
			.card-content p {
				font-size: 0.85rem;
				line-height: 1.5;
				color: #555;
				margin: 0;
			}
			.card-footer {
				margin-top: 1.5rem;
				padding-top: 0.75rem;
				border-top: 1px solid #f0f0f0;
				font-size: 0.82rem;
				font-weight: 600;
				color: #111;
			}
			.no-results {
				padding: 4rem 0;
				text-align: center;
				color: #777;
				font-family: Georgia, serif;
			}
			.hidden {
				display: none;
			}

			@media (max-width: 640px) {
				.archive-container {
					padding: 2rem 1.25rem;
				}
				.archive-header h1 {
					font-size: 2rem;
				}
				.cards-grid {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
				.recipe-card {
					padding: 1.25rem;
				}
			}
		</style>
	</body>
</html>